{
  "name": "@aegis/openclaw-governance",
  "version": "1.0.1-preview.2",
  "description": "AEGIS OpenClaw governance preview: audited chat admission, tool review, and optional adaptive model discovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.6.10"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "openclaw": "2026.6.10",
    "typescript": "^5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.10"
    },
    "build": {
      "openclawVersion": "2026.6.10"
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Digital-Mind-TripAI/AEGIS-OPENCLAW-GOVERNANCE-PLUGIN.git"
  },
  "homepage": "https://github.com/Digital-Mind-TripAI/AEGIS-OPENCLAW-GOVERNANCE-PLUGIN#readme",
  "bugs": {
    "url": "https://github.com/Digital-Mind-TripAI/AEGIS-OPENCLAW-GOVERNANCE-PLUGIN/issues"
  }
}
